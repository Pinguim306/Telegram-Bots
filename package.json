{
  "name": "arc-telegram-bots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bots de alerta de cripto para a Arc (L1 da Circle): novos launches e sinais de compra",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/doctor.ts",
    "bot:launches": "tsx src/bots/launches/index.ts",
    "bot:signals": "tsx src/bots/signals/index.ts",
    "start:launches": "node dist/bots/launches/index.js",
    "start:signals": "node dist/bots/signals/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.2.3",
    "grammy": "^1.45.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "viem": "^2.55.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
