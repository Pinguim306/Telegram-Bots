# ─────────────────────────────────────────────────────────────
#  Rede
# ─────────────────────────────────────────────────────────────
# arc-mainnet  -> rede de produção (chain 5042). Já vem configurada em
#                 config/networks.json, não precisa preencher mais nada aqui.
# arc-testnet  -> use para calibrar limiares sem publicar nada de verdade.
NETWORK=arc-mainnet

# Opcionais: só preencha para SOBRESCREVER o que está em config/networks.json.
# Env tem precedência sobre o arquivo.
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_WS_URL=
# A Arc mainnet ainda não tem block explorer público. Quando tiver, defina aqui e
# os alertas passam a incluir o link automaticamente.
ARC_MAINNET_EXPLORER=

# ─────────────────────────────────────────────────────────────
#  LEIA ISTO ANTES DE SUBIR EM PRODUÇÃO
# ─────────────────────────────────────────────────────────────
# O RPC padrão da mainnet (https://5042.rpc.thirdweb.com) é um gateway PÚBLICO e
# devolveu 429 depois de poucas chamadas durante a verificação. Ele serve para o
# doctor e para testes, mas NÃO aguenta os bots rodando de verdade.
#
# Saídas, da mais simples para a mais robusta:
#   1. chave gratuita da thirdweb -> https://5042.rpc.thirdweb.com/SEU_CLIENT_ID
#   2. RPC dedicado (Alchemy / QuickNode / dRPC)
#
# Coloque a URL aqui. Aceita várias separadas por vírgula, com failover.
# Depois de migrar, suba rateLimit em config/networks.json para 4 / 12.
RPC_URL_OVERRIDE=

# ─────────────────────────────────────────────────────────────
#  Telegram
# ─────────────────────────────────────────────────────────────
# Um token por bot (crie os dois no @BotFather).
TELEGRAM_LAUNCHES_BOT_TOKEN=
TELEGRAM_SIGNALS_BOT_TOKEN=

# Canal free (obrigatório). Use @nomedocanal ou o id numérico (-100...).
TELEGRAM_LAUNCHES_CHANNEL=
TELEGRAM_SIGNALS_CHANNEL=

# Canal premium (opcional). Recebe o alerta na hora; o free recebe com atraso.
# É a alavanca de monetização por assinatura — veja docs/MONETIZACAO.md
TELEGRAM_LAUNCHES_PREMIUM_CHANNEL=
TELEGRAM_SIGNALS_PREMIUM_CHANNEL=
FREE_TIER_DELAY_SEC=60

# ─────────────────────────────────────────────────────────────
#  Operação
# ─────────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=info

# Bloco inicial. Vazio = começa do bloco atual (recomendado em produção).
# Um número = faz backfill a partir dele.
START_BLOCK=

# DRY_RUN=true processa a chain e loga os alertas SEM publicar no Telegram.
# Use isso nos primeiros dias pra calibrar os thresholds sem queimar o canal.
DRY_RUN=true
