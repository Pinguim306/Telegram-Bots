# ─────────────────────────────────────────────────────────────
#  Modo de operação
# ─────────────────────────────────────────────────────────────
# paper -> simula as ordens com preço real de mercado, sem gastar nada.
#          É O PADRÃO. Rode assim por alguns dias antes de pensar em live.
# live  -> executa swaps de verdade via Jupiter, com o SOL da sua carteira.
TRADER_MODE=paper

# Trava de segurança do modo live: além de TRADER_MODE=live, você precisa
# digitar exatamente a frase abaixo. Sem ela o bot se recusa a operar ao vivo.
# LIVE_TRADING_ACK=eu-aceito-o-risco
LIVE_TRADING_ACK=

# ─────────────────────────────────────────────────────────────
#  Carteira (obrigatória só no modo live)
# ─────────────────────────────────────────────────────────────
# A private key da carteira que o bot vai operar. Dois formatos aceitos:
#   1. string base58 (o que a Phantom/Solflare exporta)
#   2. array JSON de bytes: [12,34,...] (o formato do solana-keygen)
#
# ⚠️  Use uma carteira DEDICADA ao bot, com só o saldo que você aceita perder.
#     Nunca a sua carteira principal. A chave nunca é logada nem gravada em disco
#     pelo bot — ela vive apenas neste arquivo, que está no .gitignore.
SOLANA_PRIVATE_KEY=

# Alternativa: caminho para um arquivo de keypair JSON (solana-keygen).
# Se os dois estiverem preenchidos, SOLANA_PRIVATE_KEY vence.
SOLANA_KEYPAIR_FILE=

# ─────────────────────────────────────────────────────────────
#  RPC da Solana
# ─────────────────────────────────────────────────────────────
# O RPC público aguenta o modo paper e testes, mas rate-limita rápido.
# Para live, use um RPC dedicado gratuito (Helius, QuickNode, Triton).
# Aceita várias URLs separadas por vírgula — o bot usa a primeira que responder.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─────────────────────────────────────────────────────────────
#  Jupiter (agregador de swap)
# ─────────────────────────────────────────────────────────────
# O endpoint gratuito (lite-api) funciona sem chave. Se você tiver uma API key
# do portal (portal.jup.ag), preencha as duas linhas para usar o endpoint pago.
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# ─────────────────────────────────────────────────────────────
#  Operação
# ─────────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
#  IA (filtro de segunda opinião antes de cada compra)
# ─────────────────────────────────────────────────────────────
# Chave da API da Anthropic (console.anthropic.com). Com ela e ai.enabled=true
# no config/trader.json, o Claude julga cada candidato aprovado nos filtros
# quantitativos ANTES da compra (timing, organicidade do volume, coerência).
# Sem a chave, o bot opera normalmente só com os filtros quantitativos.
ANTHROPIC_API_KEY=
